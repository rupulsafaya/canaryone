{
  "name": "canaryone",
  "version": "0.3.0",
  "description": "Route your test suite through every AI provider hosting your model; compare cost-per-passing-outcome and trajectory quality locally.",
  "type": "module",
  "bin": {
    "canaryone": "./bin/canaryone.mjs",
    "c1": "./bin/canaryone.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/cli.js",
    "test:tui": "node tests/tui.test.mjs",
    "test:runner": "tsx tests/runner.test.mjs",
    "test:judge": "tsx tests/judge-trajectory.test.mjs",
    "test:providers": "tsx tests/providers.test.mjs",
    "test:env-file": "tsx tests/env-file.test.mjs",
    "test:provider-catalog": "tsx tests/provider-catalog.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "chalk": "^5.4.1",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "node-pty": "^1.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "bin",
    "fixtures"
  ],
